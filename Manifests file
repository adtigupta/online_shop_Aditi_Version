apiVersion: v1
kind: Namespace
metadata:
  name: online-shop-ns



apiVersion: v1
kind: Pod
metadata:
  name: shopp
  namespace: online-shop-ns
  labels:
    app.kubernetes.io/name: proxy
spec:
  containers:
  - name: shopp-c1
    image: trainwithshubham/online_shop_app
    ports:
    - containerPort: 5173


apiVersion: apps/v1
kind: Deployment
metadata:
  name: online-shop-deployment
  namespace: online-shop-ns
  labels:
    app.kubernetes.io/name: proxy
spec:
  replicas: 5
  selector:
    matchLabels:
      app.kubernetes.io/name: proxy
  template:
    metadata:
      labels:
        app.kubernetes.io/name: proxy
    spec:
      containers:
      - name: shopp-c1
        image: trainwithshubham/online_shop_app
        ports:
        - containerPort: 5173


apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: online-shop-ss
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: proxy
  serviceName: "nginx"
  replicas: 3 # by default is 1
  minReadySeconds: 10 # by default is 0
  template:
    metadata:
      labels:
        app.kubernetes.io/name: proxy # has to match .spec.selector.matchLabels
    spec:
      terminationGracePeriodSeconds: 10
      containers:
      - name: shopp-c1
        image: trainwithshubham/online_shop_app
        ports:
        - containerPort: 5173
          name: web
        volumeMounts:
        - name: www
          mountPath: /usr/share/html
  volumeClaimTemplates:
  - metadata:
      name: www
    spec:
      accessModes: [ "ReadWriteOnce" ]
      storageClassName: "my-storage-class"
      resources:
        requests:
          storage: 1Gi


apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: ds
  namespace: online-shop-ns
  labels:
    app.kubernetes.io/name: proxy
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: proxy
  template:
    metadata:
      labels:
        app.kubernetes.io/name: proxy
    spec:
      tolerations:
      # these tolerations are to have the daemonset runnable on control plane nodes
      # remove them if your control plane nodes should not run pods
      - key: node-role.kubernetes.io/control-plane
        operator: Exists
        effect: NoSchedule
      - key: node-role.kubernetes.io/master
        operator: Exists
        effect: NoSchedule
      containers:
      - name: shop
        image: trainwithshubham/online_shop_app
        resources:
          limits:
            memory: 200Mi
          requests:
            cpu: 100m
            memory: 200Mi
        volumeMounts:
        - name: varlog
          mountPath: /var/log
      # it may be desirable to set a high priority class to ensure that a DaemonSet Pod
      # preempts running Pods
      # priorityClassName: important
      terminationGracePeriodSeconds: 30
      volumes:
      - name: varlog
        hostPath:
          path: /var/log












